# Application environment: development, test, or production
APP_ENV=development
APP_NAME=Enterprise Intranet Assistant
DEBUG=false

# Network
HOST=127.0.0.1
PORT=8000

# Security: use a randomly generated value of at least 32 characters in production.
# Do not commit a real value.
SECRET_KEY=replace-with-a-secret-at-least-32-characters

# Phase 1 reserves this setting for Phase 2. Production may not enable it.
ENABLE_DEVELOPMENT_AUTH=true
# Required only for the isolated development-token adapter. Use a separate,
# randomly generated value of at least 32 characters; never use this in production.
DEV_AUTH_SIGNING_KEY=replace-with-a-separate-development-secret-32-chars
# Authentication mode: 'development', 'local' (durable PBKDF2), or 'oidc' (corporate SSO)
AUTH_MODE=development
AUTH_AUDIENCE=enterprise-intranet-assistant
# Path to durable SQLite database for local employee accounts and session revocations
AUTH_DB_PATH=auth.sqlite3
# PBKDF2 iterations for local password hashing (production enforces minimum 600,000)
PASSWORD_HASH_ITERATIONS=600000

# Production origins allowed for CORS and CSRF validation. Must use HTTPS; no localhost in production.
ALLOWED_ORIGINS=["https://intranet.company.internal"]

# Required for production OIDC. Obtain these values from the organization's IdP.
OIDC_ISSUER=
OIDC_JWKS_URL=
# Example only: map verified IdP roles to server-side permissions.
ROLE_PERMISSION_MAP={}

# Required in production. This path must be writable only by the application
# identity and audit-log readers approved by the organization.
AUDIT_LOG_PATH=
AUDIT_RETENTION_DAYS=365

# Dependency endpoints are intentionally unset until their respective phases.
DATABASE_URL=
DATABASE_READ_ONLY=true
DATABASE_QUERY_TIMEOUT_SECONDS=10
DATABASE_MAX_RESULT_ROWS=100
LLM_BASE_URL=
LLM_ALLOWED_HOSTS=[]
LLM_ENABLED=false
LLM_MODEL=qwen3-4b-pending-license-review
LLM_MAX_OUTPUT_TOKENS=512
LLM_CONTEXT_BUDGET_TOKENS=4096
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_CONCURRENT_GENERATIONS=2
LLM_MAX_QUEUE_DEPTH=10
LLM_MAX_QUEUE_WAIT_SECONDS=30
LLM_INTERNAL_ONLY=true
DOCUMENT_ROOTS=
DOCUMENT_CHUNK_SIZE=800
DOCUMENT_CHUNK_OVERLAP=120
ORCHESTRATION_MAX_ITERATIONS=3
